{
    "name": "website",
    "description": "Adi's personal website",
    "private": true,
    "main": "public/index.html",
    "scripts": {
        "build": "run-p 'build:*'",
        "build:static": "NODE_ENV=production gatsby build",
        "build:functions": "netlify functions:build --src server/functions",
        "check": "run-p 'check:*'",
        "check:lint": "eslint .",
        "check:format": "prettier --check './**/*.{js,md,ts,tsx,json,yaml,yml}'",
        "check:types": "tsc --pretty --noEmit --project src",
        "clean": "rm -rf public/* .cache/*",
        "dev": "gatsby develop --port 9000",
        "dist": "run-s clean build",
        "fix": "run-s 'fix:*'",
        "fix:lint": "eslint --fix .",
        "fix:format": "prettier --write './**/*.{js,md,ts,tsx,json,yaml,yml}'",
        "serve-functions": "netlify dev --functions server/functions",
        "test": "echo \"No tests\" && exit 0"
    },
    "dependencies": {
        "@blueprintjs/core": "^5.16.2",
        "@blueprintjs/icons": "^5.16.0",
        "@reach/router": "^1.3.4",
        "chroma-js": "^2.6.0",
        "classnames": "^2.5.1",
        "dat.gui": "^0.7.9",
        "gatsby": "^5.14.0",
        "gatsby-adapter-netlify": "^1.2.0",
        "lodash-es": "^4.17.21",
        "p5": "^1.11.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-helmet": "^6.1.0",
        "spotify-web-api-js": "^1.5.2",
        "tone": "^14.9.17",
        "tslib": "~2.8.1",
        "whatwg-fetch": "^3.6.20"
    },
    "devDependencies": {
        "@blueprintjs/node-build-scripts": "^9.2.4",
        "@eslint/compat": "^1.2.4",
        "@eslint/js": "^9.15.0",
        "@gatsbyjs/reach-router": "^2.0.1",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
        "@stayradiated/gatsby-remark-video": "^2.4.0",
        "@types/chroma-js": "^2.4.4",
        "@types/dat.gui": "^0.7.13",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^22.10.2",
        "@types/reach__router": "^1.3.15",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-helmet": "^6.1.11",
        "@types/react-router-dom": "^5.3.3",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-formatter-codeframe": "^7.32.1",
        "eslint-plugin-eslint-comments": "^3.2.0",
        "eslint-plugin-header": "^3.1.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsdoc": "^50.5.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "gatsby-link": "^5.14.0",
        "gatsby-plugin-catch-links": "^5.14.0",
        "gatsby-plugin-google-gtag": "^5.14.0",
        "gatsby-plugin-image": "^3.14.0",
        "gatsby-plugin-react-helmet": "^6.14.0",
        "gatsby-plugin-sharp": "^5.14.0",
        "gatsby-plugin-typescript": "^5.14.0",
        "gatsby-plugin-typography": "^5.14.0",
        "gatsby-react-router-scroll": "^6.14.0",
        "gatsby-remark-copy-linked-files": "^6.14.0",
        "gatsby-remark-emoji": "^0.0.3",
        "gatsby-remark-images": "^7.14.0",
        "gatsby-source-filesystem": "^5.14.0",
        "gatsby-transformer-remark": "^6.14.0",
        "gatsby-transformer-sharp": "^5.14.0",
        "globals": "^15.12.0",
        "ky": "^1.7.2",
        "netlify-cli": "^17.37.2",
        "node-addon-api": "^8.3.0",
        "npm-run-all": "^4.1.5",
        "null-loader": "^4.0.1",
        "prettier": "3.3.3",
        "react-refresh": "^0.14.2",
        "react-typography": "^0.16.23",
        "twilio": "^5.3.6",
        "typescript": "~5.4.5",
        "typescript-eslint": "^8.18.2",
        "typography": "^0.16.24",
        "typography-theme-fairy-gates": "^0.16.19",
        "webpack": "^5.96.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/adidahiya/website"
    },
    "engines": {
        "node": ">=20.11"
    },
    "packageManager": "yarn@4.5.3"
}
